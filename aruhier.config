# clang LTO
CONFIG_LTO_CLANG_THIN_DIST=y
CONFIG_LTO=y
CONFIG_HAS_LTO_CLANG=y
CONFIG_LTO_CLANG=y

CONFIG_X86_NATIVE_CPU=y

# Avoid a 2s timeout at boot.
CONFIG_ACPI_THERMAL=m

# Needed for BPF Sched-ext
CONFIG_FTRACE=y

# Faster kernel load, cachy disables it, but arch enables it
CONFIG_DEFERRED_STRUCT_PAGE_INIT=y

# Enable BORE and CACHY tweaks
CONFIG_SCHED_BORE=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_CACHY=y

# Switch Huge Pages to always
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y

# Disable page poisoning, superseeded by INIT_ON_ALLOC_DEFAULT_ON.
# CONFIG_PAGE_POISONING is not set

# Set 1000Hz
CONFIG_HZ=1000
CONFIG_HZ_1000=y

# Gentoo
CONFIG_GENTOO_LINUX_INIT_SYSTEMD=y

# FS
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
#
# Openrgb
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_SMBUS=y
CONFIG_I2C_PIIX4=y
#
# ZSWAP
CONFIG_ZSWAP_DEFAULT_ON=y
#
# Hardware acceleration for btrfs checksums
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_CRC32C_INTEL=y
#
# Kernel compression
CONFIG_KERNEL_LZ4=y
CONFIG_MODULE_COMPRESS=n
CONFIG_MODULE_COMPRESS_ALL=n
# CONFIG_MODULE_COMPRESS_ZSTD is not set
#
# Enable PSI per default
CONFIG_PSI_DEFAULT_DISABLED=n
#
# Enable MGEN LRU
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# USB as modules, it defers the load to after loading the kernel
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_OHCI_HCD=m
CONFIG_USB_HID=m
CONFIG_HID_GENERIC=m
CONFIG_USB_SERIAL=m

# TPM as modules, defers their load to after loading the kernel
CONFIG_TCG_TPM=m
CONFIG_TCG_CRB=m
CONFIG_TCG_TIS=m
# CONFIG_TCG_TPM2_HMAC is not set
#
# AHCI
# Mark is as modular, as we don't need it for boot. It allows an async sata port discover.
CONFIG_SATA_AHCI=m
# AMD (ryzen) CPU
CONFIG_AMD_IOMMU=y
# Include AMDGPU
CONFIG_DRM_AMDGPU=m
# Exclude older models from AMDGPU to make the module lighter.
CONFIG_DRM_AMDGPU_SI=n
CONFIG_DRM_AMDGPU_CIK=n
# CONFIG_DRM_RADEON is not set
# CONFIG_FB_RADEON is not set
# CONFIG_FB_ATY128 is not set
# CONFIG_FB_ATY is not set
# NFS
CONFIG_NFS_V4=y
# Mellanox
CONFIG_MLX4_CORE=y
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX4_CORE_GEN2=y
# Infiniband is not used.
CONFIG_MLX4_INFINIBAND=n
# NVME
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

# Enable NTSYNC
CONFIG_NTSYNC=y

## Cleanup ##

CONFIG_BATMAN_ADV=n
CONFIG_MAC80211_MESH=n

# No initramfs on this box (only the uncompressed microcode cpio), so no initrd decompressors are needed
CONFIG_RD_GZIP=n
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n

# Bare metal: no VM-guest support (KVM host support is untouched)

CONFIG_XEN=n
CONFIG_HYPERV=n
CONFIG_HYPERVISOR_GUEST=n
CONFIG_KVM_GUEST=n
CONFIG_VMWARE_BALLOON=n
CONFIG_VMWARE_VMCI=n
CONFIG_PVPANIC=n
CONFIG_VMGENID=n
CONFIG_INTEL_TDX_GUEST=n
CONFIG_PCI_HYPERV=n
CONFIG_VIRTIO_BLK=n
CONFIG_VIRTIO_PCI=n
CONFIG_VIRTIO_CONSOLE=n
CONFIG_VIRTIO_FS=n

# AMD desktop: drop Intel-only platform support (CPU_SUP_INTEL itself is EXPERT-only, left alone)
CONFIG_INTEL_IOMMU=n
CONFIG_INTEL_IDLE=n
CONFIG_X86_MCE_INTEL=n
CONFIG_INTEL_HFI_THERMAL=n
CONFIG_INTEL_TDX_HOST=n
CONFIG_X86_SGX=n
CONFIG_X86_INTEL_LPSS=n
CONFIG_INTEL_SCU_PCI=n
CONFIG_INTEL_SOC_PMIC=n
CONFIG_INTEL_SOC_PMIC_CHTWC=n
CONFIG_PINCTRL_INTEL=n
CONFIG_PINCTRL_INTEL_PLATFORM=n
CONFIG_PINCTRL_BAYTRAIL=n
CONFIG_PINCTRL_LYNXPOINT=n
CONFIG_PINCTRL_ALDERLAKE=n
CONFIG_PINCTRL_BROXTON=n
CONFIG_PINCTRL_CANNONLAKE=n
CONFIG_PINCTRL_CEDARFORK=n
CONFIG_PINCTRL_DENVERTON=n
CONFIG_PINCTRL_ELKHARTLAKE=n
CONFIG_PINCTRL_EMMITSBURG=n
CONFIG_PINCTRL_GEMINILAKE=n
CONFIG_PINCTRL_ICELAKE=n
CONFIG_PINCTRL_JASPERLAKE=n
CONFIG_PINCTRL_LAKEFIELD=n
CONFIG_PINCTRL_LEWISBURG=n
CONFIG_PINCTRL_METEORLAKE=n
CONFIG_PINCTRL_METEORPOINT=n
CONFIG_PINCTRL_SUNRISEPOINT=n
CONFIG_PINCTRL_TIGERLAKE=n
CONFIG_PINCTRL_CHERRYVIEW=n
CONFIG_PINCTRL_SX150X=n
CONFIG_GPIO_CRYSTALCOVE=n
CONFIG_PWM_CRC=n
CONFIG_I2C_DESIGNWARE_PLATFORM=n
CONFIG_I2C_DESIGNWARE_PCI=n
CONFIG_INTEL_NVME_REMAP=n
CONFIG_INTEL_WMI=n
CONFIG_INTEL_WMI_SBL_FW_UPDATE=n
CONFIG_INTEL_WMI_THUNDERBOLT=n
CONFIG_X86_P4_CLOCKMOD=n
CONFIG_X86_SPEEDSTEP_LIB=n
CONFIG_X86_POWERNOW_K8=n
CONFIG_AGP=n

# SME/SEV not used (4 MB zeroed scratch area in the payload)
CONFIG_AMD_MEM_ENCRYPT=n

# LSMs: active stack is capability,landlock,lockdown,yama,bpf
CONFIG_SECURITY_SELINUX=n
CONFIG_SECURITY_APPARMOR=n
CONFIG_SECURITY_SMACK=n
CONFIG_SECURITY_TOMOYO=n
CONFIG_SECURITY_IPE=n
CONFIG_SECURITY_SAFESETID=n
CONFIG_SECURITY_LOADPIN=n
CONFIG_INTEGRITY=n
CONFIG_LSM="landlock,lockdown,yama,bpf"

# Built-in drivers with no hardware behind them (no serial port,
# EFI framebuffer is handled by SIMPLEDRM, no CXL)
CONFIG_SERIAL_8250=n
CONFIG_FB_VESA=n
CONFIG_FB_EFI=n
CONFIG_RC_CORE=m
CONFIG_CXL_BUS=n
CONFIG_ACPI_HMAT=n

#
# Not needed for boot (root is btrfs) -> modules
CONFIG_FUSE_FS=m

#
# Debug / tracing not needed in a daily kernel. Kept: FTRACE, KPROBES, BPF, BTF, DEBUG_FS (sched-ext, bpftrace)
CONFIG_ACPI_DEBUG=n
CONFIG_PM_DEBUG=n
CONFIG_FW_LOADER_DEBUG=n
CONFIG_VIRTIO_DEBUG=n
CONFIG_PNP_DEBUG_MESSAGES=n
CONFIG_DEBUG_SHIRQ=n
CONFIG_DYNAMIC_DEBUG=n
CONFIG_PRINTK_INDEX=n
CONFIG_MMIOTRACE=n
CONFIG_HWLAT_TRACER=n
CONFIG_OSNOISE_TRACER=n
CONFIG_TIMERLAT_TRACER=n
CONFIG_TRACER_SNAPSHOT=n
CONFIG_SCHED_TRACER=n
CONFIG_IRQSOFF_TRACER=n
CONFIG_PREEMPT_TRACER=n
CONFIG_HIST_TRIGGERS=n
CONFIG_SYNTH_EVENTS=n
CONFIG_USER_EVENTS=n
CONFIG_BLK_DEV_IO_TRACE=n
CONFIG_FUNCTION_GRAPH_RETVAL=n
CONFIG_FUNCTION_GRAPH_RETADDR=n
CONFIG_HARDLOCKUP_DETECTOR=n
CONFIG_SOFTLOCKUP_DETECTOR=n
CONFIG_DETECT_HUNG_TASK=n
CONFIG_RUNTIME_TESTING_MENU=n
CONFIG_HWPOISON_INJECT=n
CONFIG_TEST_POWER=n
CONFIG_MMC_TEST=n
